# 复制成 .env 再填值：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交到 git —— 令牌就放这儿。
#
# ACCESS_TOKEN 留空 = 不校验，谁碰到这个端口谁就能改卡片、导出备份。
# 只在「纯内网、机器只有你自己用」时才建议留空。
#
# 生成一条：./scripts/new-token.sh
ACCESS_TOKEN=

# 监听端口
PORT=3721

# 天气默认城市（页面上也能改）
# WEATHER_CITY=北京

# 监控地址留空 = 自动用「访问导航页的主机名:8777」
# MONITOR_URL=http://192.168.1.10:8777/#/overview

# 设了令牌后默认禁止服务端抓内网图标（防 SSRF），纯内网想关掉就设 0
# BLOCK_PRIVATE_FETCH=0

# 构建用的基础镜像。默认从 Docker Hub 拉 node:22-alpine，
# 国内经常连不上（报 context deadline exceeded）。
# 换成你能访问的镜像源即可，compose 会把它传给 Dockerfile 的 ARG：
# NODE_IMAGE=registry.cn-hangzhou.aliyuncs.com/你的命名空间/node:22-alpine
# NODE_IMAGE=node:22-alpine
